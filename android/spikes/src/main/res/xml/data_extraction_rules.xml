<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by cloud backup or phone-to-phone transfer: the database, the wrapped key and tokens
     are useless without this device's Keystore key, and a restored copy would be unreadable or stale. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>